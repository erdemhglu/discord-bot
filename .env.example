DISCORD_TOKEN=your_discord_token_here

# ai: one of these two is enough; if both are set, openrouter wins, use PROVIDER=mistral to force mistral
OPENROUTER_KEY=
MISTRAL_KEY=
PROVIDER=
MODEL=
# optional: overrides the openai-compatible chat/completions url (if you have your own router)
API_URL=

# optional
FIRECRAWL_KEY=
NEWS_CHANNEL=

# optional, if both are empty the bot runs in every server/channel it can reach.
# GUILD_ID is a single server id; CHANNELS is a comma-separated list of channel ids.
GUILD_ID=
CHANNELS=

# optional: when /debug is on, decision traces go to this channel; otherwise to the message's own channel
DEBUG_CHANNEL=

# optional, defaults to on. off/0/no -> attached images aren't read.
# read only at startup, can't be changed at runtime by any command (deliberate).
IMAGE_ANALYSIS=

# optional, defaults to tr. the bot's language: picks which prompts/<lang>/ and
# langs/<lang>.json get read, fixed for the process (BOT_LANG, not LANG: LANG is usually
# already set by the shell for the OS locale, kept separate on purpose). tr and en are filled in.
BOT_LANG=

# optional. log level: error/warn/info/debug/trace (default info).
LOG_LEVEL=
# optional. on/off (default: on in a terminal, off when logging to a file).
LOG_COLOR=
