DISCORD_TOKEN=buraya_discord_token

# yapay zeka: ikisinden biri yeter; ikisi de varsa openrouter, PROVIDER=mistral ile zorlanir
OPENROUTER_KEY=
MISTRAL_KEY=
PROVIDER=
MODEL=
# istege bagli: openai uyumlu chat/completions adresini ezer (kendi router'in varsa)
API_URL=

# istege bagli
FIRECRAWL_KEY=
NEWS_CHANNEL=

# istege bagli, ikisi de bos ise bot erisebildigi her sunucuda/kanalda calisir.
# GUILD_ID tek sunucu id'si; CHANNELS virgulle ayrilmis kanal id listesi.
GUILD_ID=
CHANNELS=

# istege bagli: /debug acikken karar izleri bu kanala gider; yoksa mesajin kanalina
DEBUG_CHANNEL=

# istege bagli, varsayilan acik. kapali/off/hayir/0 -> ekli fotograflar okunmaz.
# Yalniz acilista okunur, calisirken hicbir komutla degistirilemez (kasitli).
IMAGE_ANALYSIS=

# istege bagli, varsayilan tr. Botun dili: prompts/<dil>/ ve langs/<dil>.json'den hangisi
# okunur, sabit kalir (LANG degil BOT_LANG: LANG cogu kabukta zaten isletim sistemi
# yereli icin ayarli, karismasin diye). Su an yalniz tr dolu.
BOT_LANG=
